<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎮 FF Abhi Panel"
            android:textColor="#00FF88"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/panelPing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ping: -- ms"
            android:textColor="#00FF88"
            android:textSize="16sp"
            android:padding="8dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/panelBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Battery: --% | Temp: --°C"
            android:textColor="#00FF88"
            android:textSize="16sp"
            android:padding="8dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/panelRam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RAM: -- MB used"
            android:textColor="#00FF88"
            android:textSize="16sp"
            android:padding="8dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ Brightness"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/brightnessSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔊 Volume"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/volumeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="15"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnCleanRam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧹 RAM Clean Karo"
            android:background="#00FF88"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnClosePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ Panel Band Karo"
            android:background="#FF5555"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>

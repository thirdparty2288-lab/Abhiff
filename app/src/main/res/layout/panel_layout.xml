<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#CC0D0D0D"
    android:maxHeight="600dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/rounded_bg"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/panelPing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📶 -- ms"
                android:textColor="#00FF88"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/panelTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️ --°C"
                android:textColor="#00FF88"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/fps_bg"
            android:padding="14dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/fpsText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- FPS"
                android:textColor="#00FF88"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginLeft="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60"
                android:textColor="#444444"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnLowPower"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Low Power Mode"
                android:textSize="10sp"
                android:background="@drawable/mode_button_bg"
                android:textColor="#AAAAAA"
                android:layout_marginRight="4dp"/>

            <Button
                android:id="@+id/btnBalanced"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Balanced Mode"
                android:textSize="10sp"
                android:background="@drawable/mode_button_bg"
                android:textColor="#00FF88"
                android:layout_marginLeft="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Brightness"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginLeft="8dp"/>

                <TextView
                    android:id="@+id/brightnessValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#00FF88"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progressTint="#00FF88"
                android:progressBackgroundTint="#2A2A2A"
                android:thumbTint="#00FF88"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Volume"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:layout_marginLeft="8dp"/>

                <TextView
                    android:id="@+id/volumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#00FF88"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/volumeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15"
                android:progressTint="#00FF88"
                android:progressBackgroundTint="#2A2A2A"
                android:thumbTint="#00FF88"/>
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnGameFocus"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🎮 Game Focus"
                android:textSize="11sp"
                android:background="@drawable/tile_bg"
                android:textColor="#00FF88"/>

            <Button
                android:id="@+id/btnNotifications"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🔔 Notifications"
                android:textSize="11sp"
                android:background="@drawable/tile_bg"
                android:textColor="#00FF88"/>

            <Button
                android:id="@+id/btnCallBlocker"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🚫 Call Blocker"
                android:textSize="11sp"
                android:background="@drawable/tile_bg"
                android:textColor="#00FF88"/>

            <Button
                android:id="@+id/btnCleanRam"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="🧹 RAM Clean"
                android:textSize="11sp"
                android:background="@drawable/tile_bg"
                android:textColor="#00FF88"/>
        </GridLayout>

        <Button
            android:id="@+id/btnKillBackground"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⚡ KILL BACKGROUND"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_bg"
            android:textColor="#FF4444"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_bg"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/ramInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RAM: -- MB used"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="6dp"/>

            <ProgressBar
                android:id="@+id/cleanProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00FF88"
                android:progressBackgroundTint="#2A2A2A"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnClosePanel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="✕ CLOSE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#FF4444"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>

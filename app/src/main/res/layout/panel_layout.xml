<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#0A0A0A"
    android:maxHeight="600dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#111111"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="X-BOOST"
                android:textColor="#00FF88"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginLeft="8dp"/>

            <TextView
                android:id="@+id/fpsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 FPS"
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:background="#1A1A1A"
                android:padding="6dp"/>
        </LinearLayout>

        <!-- CPU / GPU -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#111111"
                android:padding="14dp"
                android:layout_marginRight="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU"
                    android:textColor="#666666"
                    android:textSize="9sp"/>

                <TextView
                    android:id="@+id/cpuText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#111111"
                android:padding="14dp"
                android:layout_marginLeft="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPU"
                    android:textColor="#666666"
                    android:textSize="9sp"/>

                <TextView
                    android:id="@+id/gpuText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#00FF88"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- BRIGHTNESS (CPU/GPU ke just neeche) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="12dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀️"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BRIGHTNESS"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="8dp"/>

                <TextView
                    android:id="@+id/brightnessValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#00FF88"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progressTint="#00FF88"
                android:progressBackgroundTint="#222222"
                android:thumbTint="#00FF88"/>
        </LinearLayout>

        <!-- VOLUME (Brightness ke neeche) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VOLUME"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="8dp"/>

                <TextView
                    android:id="@+id/volumeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textColor="#00AAFF"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/volumeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15"
                android:progressTint="#00AAFF"
                android:progressBackgroundTint="#222222"
                android:thumbTint="#00AAFF"/>
        </LinearLayout>

        <!-- PERFORMANCE MODES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#111111"
            android:padding="6dp"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnPowerSave"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="SAVE"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="#1A1A1A"
                android:textColor="#666666"
                android:layout_marginRight="3dp"/>

            <Button
                android:id="@+id/btnBalanced"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="BALANCED"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="#00FF88"
                android:textColor="#000000"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"/>

            <Button
                android:id="@+id/btnPerformance"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="PERF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="#1A1A1A"
                android:textColor="#666666"
                android:layout_marginLeft="3dp"/>
        </LinearLayout>

        <!-- LIVE STATS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE STATS"
                android:textColor="#666666"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/panelPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📶 Ping: -- ms"
                android:textColor="#00FF88"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="#1A1A1A"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/panelBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔋 Battery: --% | Temp: --°C"
                android:textColor="#00FF88"
                android:textSize="12sp"
                android:padding="8dp"
                android:background="#1A1A1A"/>
        </LinearLayout>

        <!-- RAM CLEANER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/cleanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEMORY CLEANER"
                android:textColor="#666666"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/ramInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RAM: -- MB used"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:layout_marginBottom="8dp"/>

            <ProgressBar
                android:id="@+id/cleanProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#00FF88"
                android:progressBackgroundTint="#222222"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnCleanRam"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="CLEAN RAM"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#00FF88"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- CLOSE -->
        <Button
            android:id="@+id/btnClosePanel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="✕ CLOSE PANEL"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#FF4444"
            android:textColor="#FFFFFF"/>

    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0A0A0A"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="36sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FF ABHI"
                    android:textColor="#FF3300"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIRE + ICE EDITION v3.0"
                    android:textColor="#00AAFF"
                    android:textSize="9sp"
                    android:letterSpacing="0.4"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="28sp"
                android:padding="8dp"
                android:background="#111111"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A0A0A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 LIVE PERFORMANCE"
                android:textColor="#FF3300"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#111111"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📶"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PING"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:layout_marginLeft="14dp"/>

                <TextView
                    android:id="@+id/tvPing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- ms"
                    android:textColor="#00AAFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#111111"
                android:padding="14dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BATTERY / TEMP"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:layout_marginLeft="14dp"/>

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--% | --°C"
                    android:textColor="#FF3300"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#111111"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="22sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RAM USED"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:letterSpacing="0.2"
                    android:layout_marginLeft="14dp"/>

                <TextView
                    android:id="@+id/tvRam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- MB"
                    android:textColor="#00AAFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSidePanel"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="🔥 SIDE PANEL ON KARO"
            android:background="#FF3300"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.15"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A0A0A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 YOUR GAMES"
                android:textColor="#00AAFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnAddGame"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="+ GAMES ADD KARO"
                android:background="#111111"
                android:textColor="#00AAFF"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/listGames"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#111111"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0A0A0A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ GAME MODE"
                android:textColor="#FF3300"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.3"
                android:layout_marginBottom="12dp"/>

            <Switch
                android:id="@+id/swDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔕  GAME MODE (DND)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:padding="14dp"
                android:background="#111111"
                android:layout_marginBottom="8dp"/>

            <Switch
                android:id="@+id/swBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☀️  BRIGHTNESS BOOST"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:letterSpacing="0.1"
                android:padding="14dp"
                android:background="#111111"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>

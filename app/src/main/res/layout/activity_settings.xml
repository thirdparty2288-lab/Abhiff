<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1A1A1A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="26sp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SETTINGS"
                android:textColor="#00FF88"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginLeft="12dp"/>
        </LinearLayout>

        <!-- DANDI SETTINGS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DANDI SETTINGS"
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Position X -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↔️ Position X (Left se)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvPosX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20"
                    android:textColor="#00FF88"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekPosX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"
                android:progress="20"
                android:progressTint="#00FF88"
                android:thumbTint="#00FF88"
                android:layout_marginBottom="12dp"/>

            <!-- Position Y -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="↕️ Position Y (Top se)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvPosY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300"
                    android:textColor="#00FF88"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekPosY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="300"
                android:progressTint="#00FF88"
                android:thumbTint="#00FF88"
                android:layout_marginBottom="12dp"/>

            <!-- Width -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Width (Patli/Moti)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvWidth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20"
                    android:textColor="#00FF88"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="80"
                android:progress="20"
                android:progressTint="#00FF88"
                android:thumbTint="#00FF88"
                android:layout_marginBottom="12dp"/>

            <!-- Height -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Height (Chhoti/Lambi)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>

                <TextView
                    android:id="@+id/tvHeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="200"
                    android:textColor="#00FF88"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="600"
                android:progress="200"
                android:progressTint="#00FF88"
                android:thumbTint="#00FF88"
                android:layout_marginBottom="12dp"/>

            <!-- Color -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Color"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <RadioGroup
                android:id="@+id/rgColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GREEN"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="12dp"/>

                <RadioButton
                    android:id="@+id/rbBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLUE"
                    android:textColor="#FFFFFF"
                    android:layout_marginRight="12dp"/>

                <RadioButton
                    android:id="@+id/rbFire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIRE"
                    android:textColor="#FFFFFF"/>
            </RadioGroup>
        </LinearLayout>

        <!-- AUTO FEATURES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO FEATURES"
                android:textColor="#00FF88"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Switch
                android:id="@+id/swAutoDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto DND on Game Launch"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="#222222"
                android:layout_marginBottom="6dp"/>

            <Switch
                android:id="@+id/swAutoBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto Brightness Max"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="#222222"
                android:layout_marginBottom="6dp"/>

            <Switch
                android:id="@+id/swAutoRam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto RAM Clean on Launch"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="#222222"
                android:layout_marginBottom="6dp"/>

            <Switch
                android:id="@+id/swGameFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎮 Game Focus (Auto App Pin)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:padding="12dp"
                android:background="#222222"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💾 SAVE SETTINGS"
            android:background="#00FF88"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp"/>

    </LinearLayout>
</ScrollView>
